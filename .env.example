# Copiez ce fichier en ".env" et remplissez les valeurs avant de démarrer l'application.
# Ne commitez JAMAIS le fichier ".env" dans un dépôt Git.

# Port d'écoute du serveur
PORT=3000

# Environnement : "development" ou "production"
NODE_ENV=development

# Secret utilisé pour signer le cookie de session.
# Générez une valeur aléatoire forte, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=remplacez_moi_par_une_valeur_aleatoire_de_64_caracteres_minimum

# Nom du cookie de session (optionnel, valeur par défaut fournie si absent)
SESSION_COOKIE_NAME=recensement.sid

# Mettre à "true" uniquement lorsque le site est servi en HTTPS (obligatoire en production)
COOKIE_SECURE=false

# Chemin du fichier de base de données SQLite
DATABASE_PATH=./data/recensement.db
