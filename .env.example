# Copiez ce fichier en ".env" en local et remplissez les valeurs.
# En production (Render, etc.), définissez ces variables directement
# dans le tableau de bord de l'hébergeur — ne commitez JAMAIS ".env".

# Port d'écoute du serveur (Render définit automatiquement PORT).
PORT=3000

# "development" ou "production".
NODE_ENV=development

# Secret utilisé pour signer le cookie de session.
# Générez une valeur aléatoire forte, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=remplacez_moi_par_une_valeur_aleatoire_de_64_caracteres_minimum

# Nom du cookie de session (optionnel).
SESSION_COOKIE_NAME=recensement.sid

# "true" uniquement lorsque le site est servi en HTTPS (obligatoire en
# production ; sur Render, c'est toujours le cas pour un service web).
COOKIE_SECURE=false

# Chaîne de connexion PostgreSQL complète.
# Sur Render : Dashboard -> votre base PostgreSQL -> "Internal Database URL"
# (à utiliser si le site est aussi hébergé sur Render, plus rapide et
# gratuit) ou "External Database URL" (utilisable depuis n'importe où).
DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/nom_de_la_base

# Mettre "false" pour une base locale sans TLS (ex. PostgreSQL en local).
# Laissé vide : activé automatiquement quand NODE_ENV=production.
DATABASE_SSL=

# Optionnel : permet de créer LE PREMIER compte administrateur via la page
# web /amorcage-admin?jeton=... , utile sur un hébergeur sans accès shell.
# Générez une valeur avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Laissez cette ligne vide/absente pour désactiver la fonctionnalité, et
# RETIREZ-LA après avoir créé le compte admin.
ADMIN_BOOTSTRAP_SECRET=
